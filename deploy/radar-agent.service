[Unit]
Description=Radar monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radar-agent
Group=radar-agent
WorkingDirectory=/opt/radar-agent
EnvironmentFile=/etc/radar-agent.env
ExecStart=/opt/radar-agent/radar-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
